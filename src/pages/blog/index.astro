---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { PROFILE } from '../../consts';
import { KIND_LABELS, published, readingTime } from '../../utils/posts';

const title = `Writing | ${PROFILE.name}`;
const description = 'Notes on agent infrastructure, memory, evaluation, and shipping software.';
const posts = published(await getCollection('blog'));
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const remaining = posts.filter((post) => post.id !== featured?.id);
---

<!doctype html>
<html lang="en">
	<head><BaseHead {title} {description} /></head>
	<body>
		<Header />
		<main id="main-content" class="wrap writing-page">
			<header class="page-head">
				<div>
					<p class="eyebrow">Writing</p>
					<h1>Notes.</h1>
				</div>
				<div class="intro">
					<p>{description}</p>
					<nav aria-label="Writing utilities">
						<a href="/search/">Search</a>
						<a href="/blog/archive/">Archive</a>
						<a href="/rss.xml">RSS</a>
					</nav>
				</div>
			</header>

			{featured && <section class="featured"><PostCard post={featured} featured /></section>}

			<section class="all-posts">
				<div class="section-head"><h2>All posts</h2><span>{posts.length} total</span></div>
				<ul>
					{remaining.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="date"><FormattedDate date={post.data.pubDate} /></span>
								<div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
								<span class="type">{KIND_LABELS[post.data.kind]} · {readingTime(post)} min</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />

		<style>
			.writing-page { padding-top: clamp(3.5rem, 8vw, 7rem); padding-bottom: clamp(5rem, 10vw, 9rem); }
			.page-head {
				display: grid;
				grid-template-columns: 2fr 1fr;
				gap: clamp(2rem, 7vw, 7rem);
				align-items: end;
				padding-bottom: clamp(3.5rem, 8vw, 6rem);
			}
			.page-head h1 { margin-top: 0.7rem; }
			.intro > p {
				font-family: var(--font-serif);
				font-size: clamp(1.2rem, 2vw, 1.45rem);
				line-height: 1.4;
				color: var(--fg);
			}
			.intro nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.4rem; }
			.intro a,
			.section-head span,
			.date,
			.type {
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--fg-3);
			}
			.intro a { border-bottom: 1px solid var(--line); padding-bottom: 0.15rem; }
			.featured { padding-bottom: clamp(5rem, 10vw, 8rem); }
			.section-head {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				border-bottom: 1px solid var(--fg);
				padding-bottom: 0.7rem;
			}
			.section-head h2 { font-size: clamp(2rem, 5vw, 3.5rem); }
			ul { list-style: none; padding: 0; margin: 0; }
			li { border-bottom: 1px solid var(--line); }
			li a {
				display: grid;
				grid-template-columns: 8rem minmax(0, 1fr) 10rem;
				gap: 1.5rem;
				align-items: baseline;
				padding: 1.35rem 0;
			}
			li a:hover { color: var(--accent); }
			li h3 { font-size: 1.3rem; margin-bottom: 0.35rem; }
			li p { font-family: var(--font-serif); margin: 0; max-width: 65ch; }
			.type { text-align: right; }
			@media (max-width: 760px) {
				.page-head { grid-template-columns: 1fr; gap: 1.4rem; }
				.page-head h1 { font-size: clamp(4rem, 22vw, 6.5rem); }
				li a { grid-template-columns: 1fr auto; gap: 0.5rem 1rem; }
				li a > div { grid-column: 1 / -1; grid-row: 2; }
				.type { grid-column: 2; grid-row: 1; }
			}
		</style>
	</body>
</html>
