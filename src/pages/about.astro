---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { PROFILE, STACK, STATS } from '../consts';

const title = `About | ${PROFILE.name}`;
const description = `${PROFILE.fullName} is a CoreSpeed cofounder and engineer building agent infrastructure, open-source systems, and complete products.`;

// Edit these freely — they drive the timeline below.
const EXPERIENCE = [
	{
		role: 'Cofounder',
		org: 'CoreSpeed',
		period: 'Present',
		detail: 'Building managed app access, tools, and memory for cloud agents.',
		points: [
			'I own the payment gateway and work across model routing, usage metering, connectors, memory, and the public product.',
			'Before the current product, we built CoreSpeed PaaS, AG0, xclaw, and Sarea. Their gateway and billing systems carried forward.',
		],
	},
	{
		role: 'Builder',
		org: 'Independent work',
		period: 'Ongoing',
		detail: 'Building complete products and publishing the engineering behind them.',
		points: [
			'BuildLog reads commits, PRs, and releases, then drafts posts for X, LinkedIn, and Bluesky.',
			'Fixo takes a mobile-mechanic workflow from diagnosis to estimate, scheduling, and Stripe payment.',
			'Lore is open-source memory infrastructure on Postgres and pgvector. Its evaluations separate a parent-memory hit from answer-bearing evidence.',
			'Claude Max Gateway exposes OpenAI and Anthropic API formats through the Claude Code CLI.',
		],
	},
];

const EDUCATION = [
	{
		role: 'M.S., Electrical Engineering (MSEE)',
		org: 'University of California, Irvine',
		period: '',
		detail: '',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main id="main-content" class="section">
			<div class="wrap about">
				<div class="about-top">
					<figure class="portrait">
						<img src="/avatar.jpg" alt="Spencer Zhao" width="400" height="400" />
					</figure>
					<div class="page-head">
						<p class="eyebrow">About</p>
						<h1>Hi, I'm Spencer.</h1>
					</div>
				</div>

				<div class="bio">
					<p>
						I'm Spencer (Yunpeng) Zhao, a cofounder and engineer at
						<a href={PROFILE.companyUrl} target="_blank" rel="noopener">CoreSpeed</a> in San Jose,
						California. I work on the non-model parts of cloud agents: app authorization, connectors,
						tools, memory, routing, usage metering, and payments.
					</p>
					<p>
						Recent work on <strong>Lore</strong> focuses on an easy measurement mistake: counting a
						retrieved record as a success before its answer-bearing evidence reaches the model. I also
						build complete products such as <strong>BuildLog</strong> and <strong>Fixo</strong>, and keep
						my early hardware projects on GitHub.
					</p>
				</div>

				<section class="block">
					<h2>By the numbers</h2>
					<div class="nums">
						{
							STATS.map((s) => (
								<div>
									<span class="nv">{s.value}</span>
									<span class="nl">{s.label}</span>
								</div>
							))
						}
					</div>
				</section>

				<section class="block">
					<h2>Experience</h2>
					<ol class="timeline">
						{
							EXPERIENCE.map((item) => (
								<li>
									<div class="row">
										<h3>
											{item.role} · <span class="org">{item.org}</span>
										</h3>
										{item.period && <span class="period">{item.period}</span>}
									</div>
									<p>{item.detail}</p>
									{item.points && (
										<ul class="pts">
											{item.points.map((p) => (
												<li>{p}</li>
											))}
										</ul>
									)}
								</li>
							))
						}
					</ol>
				</section>

				<section class="block">
					<h2>Education</h2>
					<ol class="timeline">
						{
							EDUCATION.map((item) => (
								<li>
									<div class="row">
										<h3>
											{item.role} · <span class="org">{item.org}</span>
										</h3>
										{item.period && <span class="period">{item.period}</span>}
									</div>
									{item.detail && <p>{item.detail}</p>}
								</li>
							))
						}
					</ol>
				</section>

				<section class="block">
					<h2>Toolbox</h2>
					<div class="stack">
						{
							STACK.map((g) => (
								<div class="stack-row">
									<span class="stack-label">{g.label}</span>
									<ul>
										{g.items.map((i) => (
											<li class="badge">{i}</li>
										))}
									</ul>
								</div>
							))
						}
					</div>
				</section>

				<section class="block">
					<h2>Beyond code</h2>
					<p>
						My early projects were hardware: a multi-function digital clock in Verilog on an FPGA and
						a small USB-powered lithium-battery UPS for Raspberry Pi and low-power MCUs. Both are on
						<a href="https://github.com/spinsirr" target="_blank" rel="noopener">GitHub</a>.
					</p>
				</section>

				<section class="block contact" id="contact">
					<h2>Get in touch</h2>
					<p>The fastest way to reach me is email. Copy the address, or open your mail app.</p>
					<p class="email-address" data-email-address>{PROFILE.email}</p>
					<div class="contact-actions">
						<button class="btn btn-primary" type="button" data-copy-email data-email={PROFILE.email}>Copy email</button>
						<a class="btn" href={`mailto:${PROFILE.email}`}>Open mail app</a>
						<span class="copy-status" role="status" aria-live="polite" data-copy-status></span>
					</div>
					<SocialLinks includeEmail={false} />
				</section>
			</div>
		</main>
		<Footer />

		<style>
			.about {
				max-width: 760px;
			}
			.page-head h1 {
				margin-top: 0.6rem;
				font-size: clamp(2.5rem, 7vw, 4.5rem);
			}
			.about-top {
				display: flex;
				align-items: flex-end;
				gap: 1.6rem;
				flex-wrap: wrap;
				margin-bottom: 2rem;
			}
			.portrait {
				margin: 0;
				flex: 0 0 auto;
			}
			.portrait img {
				display: block;
				width: 150px;
				height: 150px;
				object-fit: cover;
				border-radius: 50%;
				border: 2px solid var(--fg);
			}
			.bio {
				font-size: 1.08rem;
				margin-bottom: 1rem;
			}
			.bio a {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 3px;
			}
			.bio a:hover {
				color: #fff;
			}
			.block {
				margin-top: 3rem;
			}
			.block h2 {
				font-size: 1.4rem;
				margin-bottom: 1.5rem;
				padding-bottom: 0.7rem;
				border-bottom: 1px solid var(--border);
			}
			.block > p a {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 0.18em;
			}
			.timeline {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1.6rem;
			}
			.timeline li {
				position: relative;
				padding-left: 1.4rem;
			}
			.timeline li::before {
				content: '';
				position: absolute;
				left: 0;
				top: 0.55rem;
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--accent);
			}
			.timeline .row {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.5rem;
			}
			.timeline h3 {
				margin: 0;
				font-size: 1.08rem;
			}
			.timeline .org {
				color: var(--text-dim);
				font-weight: 500;
			}
			.timeline .period {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--text-mute);
			}
			.timeline p {
				margin: 0.4rem 0 0;
				font-size: 0.95rem;
			}
			.timeline .pts {
				margin: 0.7rem 0 0;
				padding-left: 1.1rem;
				display: grid;
				gap: 0.4rem;
			}
			.timeline .pts li {
				font-size: 0.92rem;
				color: var(--fg-2);
			}
			.timeline .pts li::marker {
				color: var(--accent);
			}
			.stack {
				display: grid;
				gap: 1.2rem;
			}
			.stack-row {
				display: grid;
				gap: 0.6rem;
			}
			@media (min-width: 640px) {
				.stack-row {
					grid-template-columns: 140px 1fr;
				}
			}
			.stack-label {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--text-mute);
			}
			.stack-row ul {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.contact {
				scroll-margin-top: 5rem;
			}
			.email-address {
				font-family: var(--font-mono);
				font-size: clamp(1rem, 3vw, 1.35rem);
				color: var(--fg);
				margin: 1rem 0 0;
				user-select: all;
			}
			.contact-actions {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin: 1rem 0 1.4rem;
			}
			.copy-status {
				min-height: 1em;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--fg-2);
			}
			.nums {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				border-top: 1px solid var(--line);
				border-left: 1px solid var(--line);
			}
			@media (min-width: 560px) {
				.nums {
					grid-template-columns: repeat(4, 1fr);
				}
			}
			.nums > div {
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				padding: 1.2rem;
				border-right: 1px solid var(--line);
				border-bottom: 1px solid var(--line);
			}
			.nv {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 1.8rem;
				letter-spacing: -0.02em;
			}
			.nl {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--fg-3);
			}
		</style>
		<script>
			const copyEmail = document.querySelector<HTMLButtonElement>('[data-copy-email]');
			const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
			const emailAddress = document.querySelector<HTMLElement>('[data-email-address]');

			copyEmail?.addEventListener('click', async () => {
				const address = copyEmail.dataset.email;
				if (!address || !copyStatus) return;

				try {
					if (!navigator.clipboard || !window.isSecureContext) throw new Error('Clipboard unavailable');
					await navigator.clipboard.writeText(address);
					copyStatus.textContent = 'Copied to clipboard.';
				} catch {
					if (emailAddress) {
						const range = document.createRange();
						range.selectNodeContents(emailAddress);
						const selection = window.getSelection();
						selection?.removeAllRanges();
						selection?.addRange(range);
					}
					copyStatus.textContent = 'Address selected. Copy it manually.';
				}
			});
		</script>
	</body>
</html>
