---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CONTACT_PATH, PROFILE, PROJECTS, SOCIALS } from '../consts';

const title = `About | ${PROFILE.name}`;
const description = `${PROFILE.fullName} is a CoreSpeed cofounder with an M.S. in Computer Engineering from UC Irvine, building agent infrastructure and products.`;
const socialLinks = SOCIALS.filter((social) => social.icon !== 'email');

const projectUrl = (name: string) => {
	const url = PROJECTS.find((project) => project.name === name)?.href;
	if (!url) throw new Error(`Missing public project link for ${name}`);
	return url;
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="hero wrap">
				<div class="hero-meta">
					<span>About / {PROFILE.name}</span>
					<span>{PROFILE.location}</span>
				</div>
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Cofounder &amp; engineer</p>
						<h1>Hi, I'm<br /><span>Spencer.</span></h1>
						<p class="hero-lead">
							My background is in computer engineering. I co-founded
							<a href={PROFILE.companyUrl} target="_blank" rel="noopener">{PROFILE.company}</a>
							and build the systems that let cloud agents use apps, tools, and memory.
						</p>
						<div class="hero-actions">
							<a class="btn btn-primary" href="/projects/">View work</a>
							<a class="btn" href={CONTACT_PATH}>Email me</a>
						</div>
					</div>
					<figure class="portrait">
						<img src="/avatar.jpg" alt="Portrait of Spencer Zhao" width="400" height="400" loading="eager" />
						<figcaption><span>{PROFILE.name}</span><span>{PROFILE.location}</span></figcaption>
					</figure>
				</div>
			</header>

			<section class="statement wrap" aria-labelledby="approach-heading">
				<p class="section-index">01 / Approach</p>
				<div class="statement-copy">
					<h2 id="approach-heading">The work around the model call.</h2>
					<p>
						I focus on the boundaries that make an agent useful: identity, tool access,
						state, model routing, usage, and the evidence it receives. Those details
						shape whether it can finish a task and whether someone can trust the result.
					</p>
				</div>
			</section>

			<section class="work wrap" aria-labelledby="work-heading">
				<div class="section-heading">
					<p class="section-index">02 / Work</p>
					<h2 id="work-heading">What I'm building.</h2>
				</div>
				<div class="work-list">
					<article class="work-item">
						<p class="work-number">01 / Current</p>
						<div>
							<h3><a href={PROFILE.companyUrl} target="_blank" rel="noopener">{PROFILE.company} <span aria-hidden="true">↗</span></a></h3>
							<p class="work-role">Cofounder and engineer</p>
							<p>I work on managed app access, built-in tools, durable memory, routing, usage metering, and billing for cloud agents. Earlier CoreSpeed products included PaaS, AG0, xclaw, and Sarea.</p>
						</div>
					</article>
					<article class="work-item">
						<p class="work-number">02 / Products</p>
						<div>
							<h3>Independent work</h3>
							<p><a href={projectUrl('BuildLog')} target="_blank" rel="noopener">BuildLog ↗</a> turns commits, PRs, and releases into draft posts. <a href={projectUrl('Fixo')} target="_blank" rel="noopener">Fixo ↗</a> began in late 2024 as HMLS, a mobile-mechanic platform, and now helps repair shops draft estimates and schedule work with human review.</p>
						</div>
					</article>
					<article class="work-item">
						<p class="work-number">03 / Open source</p>
						<div>
							<h3><a href={projectUrl('Lore')} target="_blank" rel="noopener">Lore <span aria-hidden="true">↗</span></a></h3>
							<p>Lore is memory infrastructure on Postgres and pgvector. Its evaluations ask whether retrieved context contains the answer-bearing evidence that actually reaches the model.</p>
						</div>
					</article>
				</div>
			</section>

			<section class="background wrap" aria-labelledby="background-heading">
				<p class="section-index">03 / Background</p>
				<div class="background-copy">
					<h2 id="background-heading">Computer engineering by training.</h2>
					<p>I earned an M.S. in Computer Engineering from the University of California, Irvine. My work spans software systems and hardware, from cloud agent infrastructure to earlier projects in Verilog and embedded power.</p>
					<div class="hardware-links">
						<a href={projectUrl('FPGA Clock')} target="_blank" rel="noopener">FPGA Clock <span aria-hidden="true">↗</span></a>
						<a href={projectUrl('Mini-UPS')} target="_blank" rel="noopener">Mini-UPS <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>

			<section class="contact invert" id="contact" aria-labelledby="contact-heading">
				<div class="wrap contact-inner">
					<p class="section-index">04 / Contact</p>
					<h2 id="contact-heading">Get in touch.</h2>
					<a class="email-address" href={CONTACT_PATH} data-email-address>{PROFILE.email}</a>
					<div class="contact-footer">
						<div class="contact-actions">
							<button class="copy-button" type="button" data-copy-email data-email={PROFILE.email}>Copy email</button>
							<span class="copy-status" role="status" aria-live="polite" data-copy-status></span>
						</div>
						<nav class="social-links" aria-label="Social profiles">
							{socialLinks.map((social) => <a href={social.href} target="_blank" rel="noopener">{social.name} ↗</a>)}
						</nav>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<style>
			.hero {
				padding-top: clamp(3rem, 7vw, 6rem);
				padding-bottom: clamp(4rem, 8vw, 7rem);
			}
			.hero-meta {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.75rem 0;
				border-top: 1px solid var(--fg);
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.09em;
				text-transform: uppercase;
				color: var(--fg-3);
			}
			.hero-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.4fr) minmax(220px, 0.6fr);
				align-items: end;
				gap: clamp(2rem, 6vw, 6rem);
				margin-top: clamp(2.5rem, 6vw, 5rem);
			}
			.hero-copy .eyebrow {
				margin: 0 0 1.2rem;
			}
			.hero h1 {
				font-size: clamp(4.2rem, 9vw, 8.8rem);
				line-height: 0.86;
				text-wrap: balance;
			}
			.hero h1 span {
				color: var(--accent);
			}
			.hero-lead {
				max-width: 38ch;
				margin: clamp(1.8rem, 4vw, 3rem) 0 0;
				font-family: var(--font-serif);
				font-size: clamp(1.35rem, 2.4vw, 1.85rem);
				line-height: 1.34;
				color: var(--fg);
				text-wrap: pretty;
			}
			.hero-lead a {
				color: inherit;
				text-decoration: underline;
				text-decoration-color: var(--accent);
				text-underline-offset: 0.17em;
			}
			.hero-lead a:hover { color: var(--accent); }
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 2rem;
			}
			.portrait {
				width: 100%;
				max-width: 350px;
				margin: 0 0 0 auto;
			}
			.portrait img {
				display: block;
				width: 100%;
				aspect-ratio: 1;
				object-fit: cover;
				border: 1px solid var(--fg);
			}
			.portrait figcaption {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				padding-top: 0.6rem;
				font-family: var(--font-mono);
				font-size: 0.63rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--fg-3);
			}
			.section-index {
				margin: 0;
				font-family: var(--font-mono);
				font-size: 0.69rem;
				letter-spacing: 0.09em;
				text-transform: uppercase;
				color: var(--accent);
			}
			.statement,
			.background {
				display: grid;
				grid-template-columns: minmax(165px, 0.32fr) minmax(0, 1fr);
				gap: clamp(2rem, 6vw, 6rem);
				padding-top: clamp(2.5rem, 5vw, 4.5rem);
				padding-bottom: clamp(4rem, 8vw, 7rem);
				border-top: 1px solid var(--fg);
			}
			.statement h2 {
				max-width: 16ch;
				font-size: clamp(2.4rem, 5.2vw, 5rem);
				line-height: 0.98;
			}
			.statement-copy > p {
				max-width: 55ch;
				margin: 1.5rem 0 0;
				font-family: var(--font-serif);
				font-size: clamp(1.15rem, 1.8vw, 1.4rem);
				line-height: 1.5;
			}
			.work {
				padding-bottom: clamp(5rem, 9vw, 8rem);
			}
			.section-heading {
				display: grid;
				grid-template-columns: minmax(165px, 0.32fr) minmax(0, 1fr);
				gap: clamp(2rem, 6vw, 6rem);
				padding-top: clamp(2.5rem, 5vw, 4.5rem);
				border-top: 1px solid var(--fg);
			}
			.section-heading h2 {
				font-size: clamp(2.5rem, 5.5vw, 5rem);
			}
			.work-list {
				margin-top: clamp(2rem, 5vw, 4rem);
				border-top: 1px solid var(--line);
			}
			.work-item {
				display: grid;
				grid-template-columns: minmax(165px, 0.32fr) minmax(0, 1fr);
				gap: clamp(2rem, 6vw, 6rem);
				padding: clamp(2rem, 4vw, 3rem) 0;
				border-bottom: 1px solid var(--line);
			}
			.work-number,
			.work-role {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.07em;
				text-transform: uppercase;
				color: var(--fg-3);
			}
			.work-number { margin: 0.45rem 0 0; }
			.work-item h3 {
				font-size: clamp(1.7rem, 3.3vw, 2.8rem);
			}
			.work-item h3 a span { color: var(--accent); }
			.work-role { margin: 0.7rem 0 1rem; }
			.work-item p:last-child {
				max-width: 62ch;
				margin-bottom: 0;
				font-family: var(--font-serif);
				font-size: clamp(1.08rem, 1.55vw, 1.25rem);
				line-height: 1.5;
			}
			.work-item p a {
				color: var(--fg);
				text-decoration: underline;
				text-decoration-color: var(--accent);
				text-underline-offset: 0.16em;
			}
			.work-item p a:hover { color: var(--accent); }
			.background h2 {
				max-width: 22ch;
				font-size: clamp(2rem, 4vw, 3.5rem);
			}
			.background-copy > p {
				max-width: 60ch;
				margin: 1.5rem 0;
				font-family: var(--font-serif);
				font-size: clamp(1.08rem, 1.55vw, 1.25rem);
				line-height: 1.5;
			}
			.hardware-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.hardware-links a {
				padding: 0.6rem 0.8rem;
				border: 1px solid var(--line);
				font-family: var(--font-mono);
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}
			.hardware-links a:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.contact {
				scroll-margin-top: 5rem;
				--contact-accent: #aebaff;
				--contact-muted: color-mix(in srgb, var(--bg) 70%, var(--fg) 30%);
				--contact-rule: color-mix(in srgb, var(--bg) 28%, transparent);
			}
			:global([data-theme='dark']) .contact {
				--contact-accent: #2438ff;
			}
			.contact-inner {
				padding-top: clamp(4rem, 8vw, 7rem);
				padding-bottom: clamp(4rem, 8vw, 7rem);
			}
			.contact .section-index { color: var(--contact-accent); }
			.contact h2 {
				margin-top: 1.5rem;
				font-size: clamp(3.2rem, 8vw, 7rem);
			}
			.email-address {
				display: inline-block;
				max-width: 100%;
				margin-top: 2rem;
				padding-bottom: 0.15rem;
				border-bottom: 2px solid var(--contact-accent);
				font-family: var(--font-display);
				font-size: clamp(1.35rem, 4vw, 3rem);
				font-weight: 600;
				letter-spacing: -0.03em;
				overflow-wrap: anywhere;
			}
			.contact-footer {
				display: flex;
				align-items: end;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 2rem;
				margin-top: clamp(2.5rem, 6vw, 5rem);
				padding-top: 1.2rem;
				border-top: 1px solid var(--contact-rule);
			}
			.contact-actions {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.8rem;
			}
			.copy-button {
				padding: 0.6rem 0.8rem;
				border: 1px solid var(--contact-muted);
				background: transparent;
				color: var(--bg);
				font-family: var(--font-mono);
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				cursor: pointer;
			}
			.copy-button:hover { background: var(--bg); color: var(--fg); }
			.copy-status {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--contact-muted);
			}
			.social-links {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem 1.5rem;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
			}
			.contact a:hover { color: var(--contact-accent); }
			.contact :focus-visible { outline-color: var(--contact-accent); }
			@media (max-width: 760px) {
				.hero-grid {
					grid-template-columns: 1fr;
				}
				.portrait {
					max-width: 280px;
					margin: 0;
				}
				.statement,
				.background,
				.section-heading,
				.work-item {
					grid-template-columns: 1fr;
					gap: 1.2rem;
				}
				.work-item { gap: 0.7rem; }
				.work-number { margin: 0; }
			}
			@media (max-width: 480px) {
				.hero-meta span:last-child { display: none; }
				.hero h1 { font-size: clamp(3.8rem, 16vw, 5.2rem); }
				.hero-lead { font-size: 1.3rem; }
				.portrait { max-width: 230px; }
			}
		</style>
		<script>
			const copyEmail = document.querySelector<HTMLButtonElement>('[data-copy-email]');
			const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
			const emailAddress = document.querySelector<HTMLElement>('[data-email-address]');

			copyEmail?.addEventListener('click', async () => {
				const address = copyEmail.dataset.email;
				if (!address || !copyStatus) return;

				try {
					if (!navigator.clipboard || !window.isSecureContext) throw new Error('Clipboard unavailable');
					await navigator.clipboard.writeText(address);
					copyStatus.textContent = 'Copied to clipboard.';
				} catch {
					if (emailAddress) {
						const range = document.createRange();
						range.selectNodeContents(emailAddress);
						const selection = window.getSelection();
						selection?.removeAllRanges();
						selection?.addRange(range);
					}
					copyStatus.textContent = 'Address selected. Copy it manually.';
				}
			});
		</script>
	</body>
</html>
