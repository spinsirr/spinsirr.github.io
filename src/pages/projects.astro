---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { PROFILE, PROJECTS, type Project, type ProjectGroup } from '../consts';

const title = `Projects | ${PROFILE.name}`;
const description = 'Selected systems, products, open-source tools, and hardware, presented chronologically.';

const groupLabels: Record<ProjectGroup, string> = {
	CoreSpeed: 'CoreSpeed',
	Products: 'Product',
	'Open source': 'Open Source',
	Hardware: 'Hardware',
};

const projects = [...PROJECTS].sort((a, b) => b.started.localeCompare(a.started));
const years = [...new Set(projects.map((project) => project.started.slice(0, 4)))];
const month = (started: string) =>
	new Intl.DateTimeFormat('en', { month: 'short', timeZone: 'UTC' })
		.format(new Date(`${started}T00:00:00Z`))
		.toUpperCase();
const dateLabel = (project: Project) => project.dateLabel ?? month(project.started);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="page-head wrap">
				<div class="head-meta">
					<span>Selected Projects</span>
					<span class="year-range">{years.at(-1)} → {years[0]}</span>
				</div>
				<h1>Selected<br />Work.</h1>
				<p class="lead">A timeline of products, infrastructure, open source, and hardware.</p>
			</header>

			<div class="timeline wrap">
				{
					years.map((year) => {
						const entries = projects.filter((project) => project.started.startsWith(year));

						return (
							<section class="year-block" aria-labelledby={`year-${year}`} data-no-reveal>
								<header class="year-head">
									<h2 id={`year-${year}`}>{year}</h2>
									<p>{entries.length} {entries.length === 1 ? 'Project' : 'Projects'}</p>
								</header>

								<ol class="year-items">
									{entries.map((project) => (
										<li class="timeline-item">
											<div class="date-rail">
												<time datetime={project.started}>{dateLabel(project)}</time>
												<span class="node" aria-hidden="true"></span>
											</div>

											<article class="project-card">
												<img class="project-image" src={project.image} alt="" loading="lazy" decoding="async" width="1280" height="720" />
												{project.imageKind === 'project' && project.imageSource ? (
													<a class="image-note" href={project.imageSource} target="_blank" rel="noopener">Project site image ↗</a>
												) : (
													<span class="image-note">AI-generated concept image</span>
												)}
												<div class="project-content">
													<header class="project-head">
														<div>
															<p class="kind">{groupLabels[project.group]}{project.badge && project.badge !== 'OSS' && ` / ${project.badge}`}</p>
															<h3>
																{project.href ? (
																	<a href={project.href} target="_blank" rel="noopener">
																		<span>{project.name}</span>
																		<span class="title-arrow" aria-hidden="true">↗</span>
																	</a>
																) : project.name}
															</h3>
														</div>
													</header>

													<p class="summary">{project.blurb}</p>

													<footer class="project-foot">
														<ul aria-label={`${project.name} technologies`}>
															{project.tags.map((tag) => <li translate="no">{tag}</li>)}
														</ul>
														{project.repo && project.repo !== project.href && <a href={project.repo} target="_blank" rel="noopener">View source</a>}
													</footer>
												</div>
											</article>
										</li>
									))}
								</ol>
							</section>
						);
					})
				}
			</div>
		</main>
		<Footer />

		<style>
			.page-head {
				padding-top: clamp(3.5rem, 8vw, 7rem);
				padding-bottom: clamp(4rem, 9vw, 8rem);
			}
			.head-meta {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				padding-bottom: 0.8rem;
				border-bottom: 1px solid var(--fg);
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--fg-3);
			}
			.year-range,
			.year-head h2,
			.date-rail time {
				font-variant-numeric: tabular-nums;
			}
			.page-head h1 {
				max-width: 8ch;
				margin-top: clamp(2rem, 5vw, 4rem);
				font-size: clamp(4.3rem, 13vw, 10rem);
				line-height: 0.82;
				text-wrap: balance;
			}
			.page-head .lead {
				margin: 1.8rem 0 0;
				font-family: var(--font-serif);
				font-size: clamp(1.2rem, 2vw, 1.55rem);
				text-wrap: pretty;
			}
			.timeline {
				max-width: 1120px;
				padding-bottom: clamp(5rem, 10vw, 9rem);
			}
			.year-block {
				display: grid;
				grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
				gap: clamp(2rem, 6vw, 5rem);
				border-top: 1px solid var(--fg);
				padding: 1.3rem 0 clamp(4.5rem, 9vw, 8rem);
			}
			.year-head {
				position: sticky;
				top: 5.2rem;
				align-self: start;
			}
			.year-head h2 {
				font-size: clamp(2.6rem, 5vw, 4.4rem);
				line-height: 0.9;
				white-space: nowrap;
				scroll-margin-top: 5.5rem;
			}
			.year-head p {
				margin: 0.7rem 0 0;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--fg-3);
			}
			.year-items {
				position: relative;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.year-items::before {
				content: '';
				position: absolute;
				top: 0.5rem;
				bottom: 0;
				left: 4.4rem;
				width: 1px;
				background: var(--line);
			}
			.timeline-item {
				display: grid;
				grid-template-columns: 5.8rem minmax(0, 1fr);
				gap: 1rem;
				position: relative;
				min-width: 0;
			}
			.timeline-item + .timeline-item {
				margin-top: clamp(2.8rem, 6vw, 5rem);
			}
			.date-rail {
				display: grid;
				grid-template-columns: 3.4rem 1fr;
				align-items: start;
				position: relative;
				padding-top: 0.25rem;
			}
			.date-rail time {
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.08em;
				color: var(--fg-3);
			}
			.node {
				position: relative;
				z-index: 1;
				display: block;
				width: 0.72rem;
				height: 0.72rem;
				margin-top: 0.05rem;
				border: 2px solid var(--bg);
				outline: 1px solid var(--accent);
				background: var(--accent);
			}
			.project-card {
				position: relative;
				isolation: isolate;
				display: flex;
				align-items: stretch;
				min-width: 0;
				min-height: 20rem;
				overflow: hidden;
				background: #111419;
				color: #fff;
			}
			.project-card::before {
				content: '';
				position: absolute;
				z-index: -1;
				inset: 0;
				background: linear-gradient(90deg, rgba(9, 12, 17, 0.97) 0%, rgba(9, 12, 17, 0.82) 49%, rgba(9, 12, 17, 0.28) 100%);
			}
			.project-image {
				position: absolute;
				z-index: -2;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
			}
			.image-note {
				position: absolute;
				top: 1rem;
				right: 1rem;
				font-family: var(--font-mono);
				font-size: 0.55rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: rgba(255, 255, 255, 0.8);
				text-shadow: 0 1px 6px #000;
			}
			.project-card a.image-note {
				color: rgba(255, 255, 255, 0.8);
			}
			.project-content {
				display: flex;
				flex-direction: column;
				width: min(100%, 37rem);
				padding: clamp(1.4rem, 3vw, 2.2rem);
			}
			.project-head {
				display: flex;
				align-items: start;
				justify-content: space-between;
				gap: 1.5rem;
			}
			.project-head > div {
				min-width: 0;
			}
			.kind {
				margin: 0 0 0.65rem;
				font-family: var(--font-mono);
				font-size: 0.65rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #b6c8ff;
			}
			.project-head h3 {
				font-size: clamp(1.8rem, 4.5vw, 3.4rem);
				line-height: 0.95;
				text-wrap: balance;
				overflow-wrap: anywhere;
				color: #fff;
			}
			.project-head h3 a {
				display: inline-flex;
				align-items: flex-start;
				gap: 0.35em;
				min-height: 2.75rem;
				text-decoration: none;
				color: inherit;
			}
			.title-arrow {
				flex: 0 0 auto;
				margin-top: 0.05em;
				font-family: var(--font-mono);
				font-size: 0.36em;
				line-height: 1;
				color: #b6c8ff;
			}
			.summary {
				max-width: 58ch;
				margin: 1.1rem 0 1.4rem;
				font-family: var(--font-serif);
				font-size: clamp(1.08rem, 1.7vw, 1.3rem);
				line-height: 1.55;
				color: rgba(255, 255, 255, 0.9);
				text-wrap: pretty;
				overflow-wrap: anywhere;
			}
			.project-foot {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin-top: auto;
			}
			.project-foot ul {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem 0.9rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.project-foot li,
			.project-foot > a {
				font-family: var(--font-mono);
				font-size: 0.68rem;
				color: rgba(255, 255, 255, 0.74);
			}
			.project-foot li::before {
				content: '#';
				color: #b6c8ff;
			}
			.project-foot > a {
				min-height: 2.75rem;
				display: inline-flex;
				align-items: center;
				text-decoration: underline;
				text-underline-offset: 0.18em;
				touch-action: manipulation;
			}
			.project-foot > a:hover,
			.project-head h3 a:hover,
			.project-card a.image-note:hover {
				color: #b6c8ff;
			}

			@media (max-width: 720px) {
				.page-head h1 {
					font-size: clamp(4rem, 22vw, 7rem);
				}
				.year-block {
					display: block;
					padding-bottom: 4.5rem;
				}
				.year-head {
					position: static;
					display: flex;
					align-items: end;
					justify-content: space-between;
					margin-bottom: 2.5rem;
				}
				.year-head p {
					margin-bottom: 0.25rem;
				}
				.timeline-item {
					grid-template-columns: 4.7rem minmax(0, 1fr);
					gap: 0.4rem;
				}
				.year-items::before {
					left: 3.75rem;
				}
				.date-rail {
					grid-template-columns: 3rem 1fr;
				}
				.project-head h3 {
					font-size: clamp(1.75rem, 9vw, 2.7rem);
				}
				.project-card {
					min-height: 25rem;
				}
				.project-card::before {
					background: linear-gradient(90deg, rgba(9, 12, 17, 0.94) 0%, rgba(9, 12, 17, 0.69) 100%);
				}
				.project-image {
					object-position: 60% center;
				}
				.project-content {
					padding: 1.2rem 1.2rem 2.4rem;
				}
				.image-note {
					top: auto;
					bottom: 0.65rem;
					right: 0.65rem;
					font-size: 0.48rem;
				}
				.project-foot {
					align-items: flex-start;
					flex-direction: column;
				}
			}

		</style>
	</body>
</html>
