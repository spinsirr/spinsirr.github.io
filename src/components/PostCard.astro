---
import FormattedDate from './FormattedDate.astro';
import type { Post } from '../utils/posts';
import { KIND_LABELS, readingTime } from '../utils/posts';

interface Props {
	post: Post;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<a class:list={['post-card', { featured }]} href={`/blog/${post.id}/`}>
	{post.data.ogImage && featured && <img src={post.data.ogImage} alt="" width="1200" height="630" loading="lazy" />}
	<div class="body">
		<div class="meta">
			<span>{KIND_LABELS[post.data.kind]}</span>
			<span><FormattedDate date={post.data.pubDate} /></span>
			<span>{readingTime(post)} min</span>
		</div>
		<h2>{post.data.title}</h2>
		<p>{post.data.description}</p>
	</div>
</a>

<style>
	.post-card {
		display: block;
		height: 100%;
		border-top: 1px solid var(--line);
		color: var(--fg);
	}
	.post-card:hover {
		color: var(--accent);
	}
	.body {
		padding: 1.25rem 0 1.75rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--fg-3);
	}
	.meta span:first-child {
		color: var(--accent);
	}
	h2 {
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		line-height: 1.04;
		margin: 0.9rem 0 0.65rem;
		max-width: 22ch;
	}
	p {
		font-family: var(--font-serif);
		font-size: 1.03rem;
		line-height: 1.5;
		max-width: 60ch;
		margin: 0;
	}
	img {
		display: block;
		width: 100%;
		aspect-ratio: 5 / 2;
		object-fit: cover;
		background: #111;
		border: 1px solid var(--line);
	}
	.featured {
		border-top-color: var(--fg);
	}
	.featured .body {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: clamp(1.5rem, 5vw, 5rem);
		align-items: start;
	}
	.featured .meta {
		grid-column: 1 / -1;
	}
	.featured h2 {
		font-size: clamp(2.2rem, 5vw, 4.5rem);
		margin: 0;
		max-width: 17ch;
	}
	.featured p {
		font-size: clamp(1.12rem, 2vw, 1.35rem);
		color: var(--fg-2);
	}
	@media (max-width: 700px) {
		img { aspect-ratio: 16 / 9; }
		.featured .body { grid-template-columns: 1fr; gap: 0.8rem; }
		.featured .meta { grid-column: auto; }
	}
</style>
