---
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Post } from '../utils/posts';
import { KIND_LABELS, readingTime, tagSlug } from '../utils/posts';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	related: Post[];
	previous?: Post;
	next?: Post;
}

const { post, headings, related, previous, next } = Astro.props;
const { title, description, pubDate, updatedDate, kind, tags, series } = post.data;
const ogImage = post.data.ogImage ?? `/og/${post.id}.png`;
const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const blogLd = {
	'@context': 'https://schema.org',
	'@type': kind === 'research' ? 'ScholarlyArticle' : 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	author: { '@type': 'Person', name: 'Spencer Zhao', url: 'https://spinsirr.github.io' },
	keywords: tags.join(', '),
	url: postUrl,
	mainEntityOfPage: postUrl,
	image: new URL(ogImage, Astro.site).toString(),
};
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage} type="article" />
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(blogLd)} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="article-top wrap">
				<a href="/blog">← Writing</a>
				<button type="button" aria-live="polite" data-copy-md>Copy Markdown</button>
			</div>

			<div class="article-shell wrap">
				<article data-pagefind-body>
					<header class="article-head">
						<div class="meta">
							<span><FormattedDate date={pubDate} /></span>
							<span>{KIND_LABELS[kind]}</span>
							<span>{readingTime(post)} min read</span>
							{series && <a href={`/blog/series/${series.slug}/`}>{series.title} #{series.order}</a>}
						</div>
						<h1 data-pagefind-meta="title">{title}</h1>
						<p class="dek" data-pagefind-meta="description">{description}</p>
						{tags.length > 0 && <p class="tags">{tags.map((tag, index) => <><a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a>{index < tags.length - 1 && <span>/</span>}</>)}</p>}
					</header>

					<div class="prose"><slot /></div>

					<footer class="article-end">
						<p>Spencer Zhao · <a href="https://corespeed.io">CoreSpeed</a></p>
						{updatedDate && <p>Updated <FormattedDate date={updatedDate} /></p>}
					</footer>
				</article>

				<aside class="toc-rail"><TableOfContents headings={headings} /></aside>
			</div>

			<div class="post-nav wrap">
				{previous ? <a href={`/blog/${previous.id}/`}><span>Previous</span><strong>{previous.data.title}</strong></a> : <span></span>}
				{next ? <a class="next" href={`/blog/${next.id}/`}><span>Next</span><strong>{next.data.title}</strong></a> : <span></span>}
			</div>

			{related.length > 0 && (
				<section class="related wrap">
					<h2>Related</h2>
					<ul>{related.map((item) => <li><a href={`/blog/${item.id}/`}>{item.data.title}</a></li>)}</ul>
				</section>
			)}
		</main>
		<Footer />

		<style>
			.article-top {
				max-width: 1040px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-top: 2rem;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.05em;
				text-transform: uppercase;
			}
			.article-top button {
				border: 0;
				border-bottom: 1px solid var(--line);
				padding: 0 0 0.15rem;
				background: none;
				color: var(--fg-3);
				font: inherit;
				cursor: pointer;
			}
			.article-shell {
				max-width: 1040px;
				display: grid;
				grid-template-columns: minmax(0, 720px) minmax(180px, 220px);
				gap: clamp(2.5rem, 6vw, 6rem);
				align-items: start;
				padding-top: clamp(3rem, 7vw, 6rem);
			}
			.article-head { padding-bottom: 2.5rem; border-bottom: 1px solid var(--fg); }
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 1rem;
				font-family: var(--font-mono);
				font-size: 0.66rem;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--fg-3);
			}
			.meta a { color: var(--accent); }
			.article-head h1 {
				font-size: clamp(3.1rem, 7vw, 6rem);
				line-height: 0.94;
				text-wrap: balance;
				margin-top: 1.3rem;
			}
			.dek {
				font-family: var(--font-serif);
				font-size: clamp(1.25rem, 2.2vw, 1.58rem);
				line-height: 1.4;
				color: var(--fg-2);
				margin: 1.4rem 0 0;
			}
			.tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.4rem 0 0; }
			.tags a,
			.tags span { font-family: var(--font-mono); font-size: 0.64rem; color: var(--fg-3); }
			.tags a:hover { color: var(--accent); }
			.toc-rail { position: sticky; top: 5.5rem; }
			.prose {
				font-family: var(--font-serif);
				font-size: clamp(1.14rem, 1.5vw, 1.28rem);
				line-height: 1.72;
				padding-top: 2.5rem;
			}
			.prose :global(p) { color: var(--fg); margin: 0 0 1.35em; }
			.prose :global(h2),
			.prose :global(h3) { scroll-margin-top: 6rem; }
			.prose :global(h2) {
				font-size: clamp(2rem, 4vw, 3.15rem);
				line-height: 1;
				margin: 2.3em 0 0.65em;
				padding-top: 0.35em;
				border-top: 1px solid var(--fg);
			}
			.prose :global(h3) { font-size: 1.55rem; margin: 2em 0 0.7em; }
			.prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
			.prose :global(ul),
			.prose :global(ol) { color: var(--fg); padding-left: 1.4em; margin: 0 0 1.5em; }
			.prose :global(li) { padding-left: 0.25em; margin-bottom: 0.45em; }
			.prose :global(li::marker) { color: var(--accent); }
			.prose :global(blockquote) { margin: 2rem 0; padding: 0.4rem 0 0.4rem 1.4rem; border-left: 3px solid var(--accent); font-size: 1.45rem; }
			.prose :global(p:has(> img:only-child)) { width: 100%; margin: 2.4rem 0 0.65rem; }
			.prose :global(p:has(> img:only-child) img) { width: 100%; display: block; border: 1px solid var(--fg); background: #101113; }
			.prose :global(p:has(> em:only-child)) { font-family: var(--font-mono); font-size: 0.68rem; line-height: 1.5; color: var(--fg-3); border-left: 2px solid var(--accent); padding-left: 0.75rem; margin: 0.65rem 0 2.4rem; }
			.prose :global(table) { width: 100%; border-collapse: collapse; margin: 2rem 0; font-family: var(--font-sans); font-size: 0.88rem; }
			.prose :global(th),
			.prose :global(td) { border-bottom: 1px solid var(--line); text-align: left; padding: 0.65rem 0.5rem; }
			.prose :global(th) { border-color: var(--fg); font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; }
			.prose :global(.footnotes) { margin-top: 3rem; border-top: 1px solid var(--fg); font-size: 0.9rem; }
			.prose :global(.expressive-code) { margin: 2rem 0; font-family: var(--font-mono); }
			.article-end { display: flex; justify-content: space-between; gap: 1rem; margin-top: 4rem; border-top: 1px solid var(--fg); padding-top: 1rem; }
			.article-end p { font-family: var(--font-mono); font-size: 0.68rem; color: var(--fg-3); margin: 0; }
			.post-nav {
				max-width: 1040px;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 3rem;
				margin-top: 5rem;
				padding-top: 1rem;
				border-top: 1px solid var(--fg);
			}
			.post-nav a { display: flex; flex-direction: column; gap: 0.45rem; }
			.post-nav span { font-family: var(--font-mono); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fg-3); }
			.post-nav strong { font-family: var(--font-display); font-size: 1.1rem; max-width: 30ch; }
			.post-nav .next { text-align: right; align-items: end; }
			.related { max-width: 1040px; padding-top: 5rem; padding-bottom: 6rem; }
			.related h2 { font-size: 1.4rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--fg); }
			.related ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
			.related li { padding-top: 0.8rem; font-family: var(--font-display); font-weight: 600; line-height: 1.2; }
			@media (max-width: 920px) {
				.article-shell { display: block; max-width: 720px; }
				.article-top { max-width: 720px; }
				.toc-rail { display: none; }
			}
			@media (max-width: 700px) {
				.article-head h1 { font-size: clamp(2.8rem, 13vw, 4.6rem); }
				.related ul { grid-template-columns: 1fr; gap: 0; }
				.related li { border-bottom: 1px solid var(--line); padding: 0.9rem 0; }
			}
		</style>
		<script>
			const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-md]');
			copyButton?.addEventListener('click', async () => {
				try {
					const url = location.pathname.replace(/\/+$/, '') + '.md';
					const markdown = await fetch(url).then((response) => response.text());
					await navigator.clipboard.writeText(markdown);
					copyButton.textContent = 'Copied ✓';
					setTimeout(() => (copyButton.textContent = 'Copy Markdown'), 1600);
				} catch { copyButton.textContent = 'Copy failed'; }
			});
		</script>
	</body>
</html>
